PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/smartdeal
# Comma-separated list of storefront origins allowed to call the API
CLIENT_URL=http://localhost:8080
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
NODE_ENV=development
# Use "none" (with HTTPS) when the storefront and API are on different domains
COOKIE_SAMESITE=lax

# Card Payments:
# When STRIPE_SECRET_KEY is supplied, real Stripe payment intents are used in AED currency.
# When omitted or PAYMENT_MODE=test, simulated test card checkout is active.
PAYMENT_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional Emails (Order receipts, status updates, password resets):
# Option A: SMTP (SendGrid, Mailgun, AWS SES, Gmail SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Smart Deal" <no-reply@smartdeal.ae>

# Option B: Resend API
RESEND_API_KEY=

# SMS Gateway (Twilio / UAE SMS Gateway for OTP verification):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional Google Identity Services client ID for "Sign in with Google"
GOOGLE_CLIENT_ID=

# Public address of this API including /api, used for links in emails (newsletter unsubscribe),
# e.g. https://api.smartdeal.ae/api. Defaults to http://localhost:PORT/api when empty.
PUBLIC_API_URL=

# Key that encrypts admins' two-step sign-in secrets (any long random string).
# Falls back to JWT_SECRET when empty. Changing it later breaks existing authenticator setups.
MFA_ENCRYPTION_KEY=
